FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk add --no-cache \
      'postfix=3.11.7-r0' \
      lmdb \
      ca-certificates \
      tzdata \
    && rm -rf /var/cache/apk/*

COPY postfix/startup.sh /usr/local/bin/startup.sh
COPY postfix/healthcheck.sh /usr/local/bin/healthcheck.sh

RUN chmod 0755 /usr/local/bin/startup.sh /usr/local/bin/healthcheck.sh

USER root
WORKDIR /tmp

EXPOSE 25

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/healthcheck.sh"]

ENTRYPOINT ["/usr/local/bin/startup.sh"]
